# ─── Application ───
APP_NAME=SupportAI-Agent
APP_ENV=development          # development | production
LOG_LEVEL=INFO               # DEBUG, INFO, WARNING, ERROR
LOG_DIR=logs                 # Directory for rotating log files (relative to project root)
TEST_MODE_FAST=false         # Reduces iterations and retries for testing

# ─── PostgreSQL ───
POSTGRES_USER=postgres       # Also used by docker-compose for the postgres container
POSTGRES_PASSWORD=change_me  # Also used by docker-compose for the postgres container
POSTGRES_DB=support_agent_db # Also used by docker-compose for the postgres container
DB_HOST=127.0.0.1            # Overridden to "postgres" inside docker-compose
DB_PORT=5432
DB_USER=postgres
DB_PASS=change_me
DB_NAME=support_agent_db

# ─── Qdrant ───
QDRANT_URL=http://127.0.0.1:6333   # Overridden to "http://qdrant:6333" inside docker-compose
QDRANT_API_KEY=                     # Required for Qdrant Cloud
QDRANT_TIMEOUT=60                   # Timeout in seconds for Qdrant operations

# ─── Embedding ───
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# ─── Qdrant Search Tuning ───
QDRANT_HNSW_EF=128
QDRANT_INDEXED_ONLY=false
QDRANT_ON_DISK_PAYLOAD=true

# ─── Per-Collection Score Thresholds ───
QDRANT_SCORE_TOOL_CATALOG=0.15
QDRANT_SCORE_ADAPTIVE_FIXES=0.75
QDRANT_SCORE_EVIDENCE=0.7
QDRANT_SCORE_KNOWLEDGE_BASE=0.5
QDRANT_SCORE_RESOLVED_TICKETS=0.0
QDRANT_SCORE_TOOL_KNOWLEDGE=0.0

# ─── Hybrid Search ───
QDRANT_HYBRID_ENABLED=false
QDRANT_HYBRID_COLLECTIONS=["tool_catalog", "adaptive_fixes", "knowledge_base"]

# ─── LLM (per-agent model governance) ───
OPENAI_API_KEY=sk-...
LLM_MODEL_CLASSIFIER=gpt-5.4-nano
LLM_MODEL_CONTEXT=gpt-5.4-nano
LLM_MODEL_MAPPER=gpt-5.4-nano
LLM_MODEL_SUPERVISOR=gpt-5.4-mini
LLM_MODEL_EVIDENCE_COLLECTOR=gpt-5.4-mini
LLM_MODEL_ENRICHER=gpt-5.4-mini
LLM_MODEL_HYPOTHESIS=gpt-5.4
LLM_MODEL_INVESTIGATOR=gpt-5.4-mini
LLM_MODEL_PLANNER=gpt-5.4
LLM_MODEL_RESPONSE=gpt-5.4-nano
LLM_MODEL_ADAPTIVE_FIX=gpt-5.4-nano
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE_DEFAULT=0.0

# ─── MCP Servers ───
# MCP_SERVERS={}                      # JSON dict, or use per-server env vars below
# MCP_SERVER_TIMEOUT=30
# MCP_SERVER_VENDOR_MAP={}            # JSON dict: {"server-name": "vendor-name"}

# ─── JWT / Authentication ───
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION   # MUST change for production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Password Policy ───
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_SYMBOL=true

# ─── Bootstrap ───
BOOTSTRAP_ADMIN_EMAIL=admin@localhost     # Email for the first super admin user

# ─── Safety & Governance ───
# SAFETY_BLOCKED_KEYWORDS=["debug flow","sniffer","packet capture",...]

# ─── Langfuse Observability (optional, disabled by default) ───
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_FLUSH_AT=15
LANGFUSE_FLUSH_INTERVAL=5

# ─── Docker Compose Ports (optional overrides) ───
# APP_PORT=8000
# FRONTEND_PORT=3001
# POSTGRES_PORT=5432
# QDRANT_PORT=6333
# QDRANT_GRPC_PORT=6334
# LANGFUSE_PORT=3000
# UVICORN_WORKERS=1

# ─── Langfuse Self-Hosted (only if using observability profile) ───
# LANGFUSE_DB=langfuse
# LANGFUSE_NEXTAUTH_SECRET=changeme-generate-a-secret
# LANGFUSE_SALT=changeme-generate-a-salt
