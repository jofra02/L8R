# ─── Application ───
APP_NAME=SupportAI-Agent
APP_ENV=development          # development | production
LOG_LEVEL=INFO               # DEBUG, INFO, WARNING, ERROR
LOG_DIR=logs
TEST_MODE_FAST=false

# ─── Pipeline ───
PIPELINE_MODE=engineer       # "engineer" (current single-agent ReAct); "pipeline" is a DEPRECATED legacy toggle

# ─── Engineer Agent ───
LLM_MODEL_ENGINEER=gpt-5.4
ENGINEER_MAX_TOOL_CALLS=30
ENGINEER_MAX_ITERATIONS=50
ENGINEER_TIMEOUT_SECONDS=600

# ─── PostgreSQL ───
# Canonical DB credentials — docker-compose maps these to the postgres container.
# No need for separate POSTGRES_USER/PASSWORD/DB vars.
DB_HOST=127.0.0.1            # Overridden to "postgres" inside docker-compose
DB_PORT=5432
DB_USER=postgres
DB_PASS=change_me
DB_NAME=support_agent_db

# ─── Qdrant ───
QDRANT_URL=http://127.0.0.1:6333   # Overridden to "http://qdrant:6333" inside docker-compose
QDRANT_API_KEY=                     # Required only for Qdrant Cloud
QDRANT_TIMEOUT=60

# ─── Embedding ───
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# ─── Qdrant Search Tuning ───
QDRANT_HNSW_EF=128
QDRANT_INDEXED_ONLY=false
QDRANT_ON_DISK_PAYLOAD=true

# ─── Per-Collection Score Thresholds ───
QDRANT_SCORE_TOOL_CATALOG=0.15
QDRANT_SCORE_ADAPTIVE_FIXES=0.75
QDRANT_SCORE_EVIDENCE=0.7
QDRANT_SCORE_KNOWLEDGE_BASE=0.5
QDRANT_SCORE_RESOLVED_TICKETS=0.0
QDRANT_SCORE_TOOL_KNOWLEDGE=0.0

# ─── Hybrid Search ───
QDRANT_HYBRID_ENABLED=false
QDRANT_HYBRID_COLLECTIONS=["tool_catalog", "adaptive_fixes", "knowledge_base"]

# ─── LLM (per-agent model governance) ───
OPENAI_API_KEY=sk-...
LLM_MODEL_CLASSIFIER=gpt-5.4-nano
LLM_MODEL_CONTEXT=gpt-5.4-nano
LLM_MODEL_MAPPER=gpt-5.4-nano
LLM_MODEL_SUPERVISOR=gpt-5.4-mini
LLM_MODEL_EVIDENCE_COLLECTOR=gpt-5.4-mini
LLM_MODEL_ENRICHER=gpt-5.4-mini
LLM_MODEL_HYPOTHESIS=gpt-5.4
LLM_MODEL_INVESTIGATOR=gpt-5.4-mini
LLM_MODEL_PLANNER=gpt-5.4
LLM_MODEL_RESPONSE=gpt-5.4-nano
LLM_MODEL_ADAPTIVE_FIX=gpt-5.4-nano
LLM_REASONING_EFFORT=low            # low | medium | high | null
LLM_TEMPERATURE_DEFAULT=0.0

# ─── MCP Servers ───
# Server definitions live in data/mcp/servers.yaml (not here).
# See data/mcp/servers.example.yaml for configuration examples.
# MCP_SERVER_TIMEOUT=30               # Global timeout; per-server override in YAML
# MCP_GATEWAY_URL=http://localhost:8001/sse   # Interpolated into servers.yaml; compose sets http://mcp-gateway:8000/sse

# ─── MCP Gateway (mcp_gateway/ service — used by docker-compose) ───
# ACTIVE_CUSTOMER_ID=fake_client      # Tenant served by the gateway (matches mcp_gateway/inventory/tenants/)
# INVENTORY_MASTER_KEY=               # Fernet key for ENC(...) device tokens — generate: uv run python mcp_gateway/scripts/encrypt_secret.py --generate
# MCP_GATEWAY_PORT=8001               # Host port published for the gateway SSE endpoint
# MCP_GATEWAY_LOG_LEVEL=info
# GATEWAY_ADMIN_TOKEN=                # Shared secret for the gateway admin API (X-Admin-Token). Unset = admin API disabled.
# MCP_GATEWAY_ADMIN_URL=http://localhost:8001   # Admin API base URL used by the app for inventory sync; compose sets http://mcp-gateway:8000
# MCP_GATEWAY_ADMIN_TOKEN=            # Usually the same value as GATEWAY_ADMIN_TOKEN (compose wires it automatically)

# ─── JWT / Authentication ───
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION   # MUST change for production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Password Policy ───
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_SYMBOL=true

# ─── Bootstrap ───
BOOTSTRAP_ADMIN_EMAIL=admin@localhost

# ─── Safety & Governance ───
# SAFETY_BLOCKED_KEYWORDS=["debug flow","sniffer","packet capture",...]

# ─── Langfuse Observability (optional, disabled by default) ───
# Bootstrap: deploy with LANGFUSE_ENABLED=false first, create a project in
# the Langfuse UI, copy the API keys, then set them here and restart the app.
# See docs/setup/deployment.md for the full step-by-step.
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=                  # obtained from Langfuse UI after project creation
# LANGFUSE_SECRET_KEY=                  # obtained from Langfuse UI after project creation
LANGFUSE_HOST=http://localhost:3000      # docker-compose overrides to http://langfuse:3000
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_FLUSH_AT=15
LANGFUSE_FLUSH_INTERVAL=5

# ─── Langfuse Self-Hosted (required for --profile observability) ───
# LANGFUSE_DB=langfuse                               # must create manually: createdb -U $DB_USER langfuse
# LANGFUSE_NEXTAUTH_SECRET=                           # generate: openssl rand -base64 32
# LANGFUSE_SALT=                                      # generate: openssl rand -base64 32

# ─── Cloudflare Tunnel (required for --profile tunnel) ───
# COMPOSE_PROFILES=tunnel             # enable the cloudflared service (opt-in, like observability)
# CLOUDFLARE_TUNNEL_TOKEN=            # token from Cloudflare Zero Trust > Tunnels; cloudflared crash-loops without it

# ─── Docker Compose (only used by docker-compose, not the app) ───
# APP_PORT=8000
# FRONTEND_PORT=3001
# POSTGRES_PORT=5432
# QDRANT_PORT=6333
# QDRANT_GRPC_PORT=6334
# LANGFUSE_PORT=3000
# UVICORN_WORKERS=1
