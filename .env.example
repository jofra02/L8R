# ─── Application ───
APP_NAME=SupportAI-Agent
APP_ENV=development
LOG_LEVEL=INFO

# ─── PostgreSQL ───
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=change_me
DB_NAME=support_agent_db

# ─── Qdrant ───
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# ─── LLM (per-agent model governance) ───
OPENAI_API_KEY=sk-...
LLM_MODEL_CLASSIFIER=gpt-4.1-nano
LLM_MODEL_MAPPER=gpt-4.1-nano
LLM_MODEL_ENRICHER=gpt-4.1-mini
LLM_MODEL_HYPOTHESIS=gpt-4.1
LLM_MODEL_INVESTIGATOR=gpt-4.1
LLM_MODEL_PLANNER=gpt-4.1
LLM_MODEL_RESPONSE=gpt-4.1-mini
LLM_MODEL_EVIDENCE_COLLECTOR=gpt-4.1-mini
LLM_REASONING_EFFORT=low

# ─── MCP Servers ───
MCP_SERVERS=remote-server
MCP_remote_server_URL=http://localhost:8000/sse
MCP_remote_server_TRANSPORT=sse

# ─── Feature Flags ───
TEST_MODE_FAST=false
