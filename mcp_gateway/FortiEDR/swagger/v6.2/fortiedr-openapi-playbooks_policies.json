  "definitions": {
    "ActionToConnectorsMap": {
      "type": "object",
      "required": [
        "actionName",
        "connectors"
      ],
      "properties": {
        "actionName": {
          "type": "string",
          "description": "AIR action name (in the translated/technical form). Applicable only to actions associated with Connectors."
        },
        "connectors": {
          "type": "array",
          "description": "List of connectors to be mapped to the action. Missing connectors will be unmapped for the specified action. Empty list will unselect all connectors.",
          "items": {
            "type": "string"
          }
        }
      },
      "title": "ActionToConnectorsMap"
    },
    "ActionsToClassificationMap": {
      "type": "object",
      "required": [
        "actionName",
        "classifications"
      ],
      "properties": {
        "actionName": {
          "type": "string",
          "example": "Block address on Firewall, BlockAddressOnFirewall, Custom Action Name, etc.",
          "description": "AIR action name (in the translated/technical form)."
        },
        "classifications": {
          "type": "array",
          "description": "List of classifications (in the translated/technical form) to be enabled. Missing classifications will be disabled for the specified action.",
          "items": {
            "type": "string"
          }
        }
      },
      "title": "ActionsToClassificationMap"
    },
    "AgentGroupEntity": {
      "type": "object",
      "properties": {
        "Name": {
          "type": "string"
        },
        "collectorsAwaitingUpgradeCount": {
          "type": "integer",
          "format": "int32"
        },
        "excludeFromIotScans": {
          "type": "boolean"
        },
        "highSecurity": {
          "type": "boolean"
        },
        "isolated": {
          "type": "boolean"
        },
        "linuxDowngradeAllowed": {
          "type": "boolean"
        },
        "linuxTargetVersion": {
          "type": "string"
        },
        "linuxTargetVersionUpdateTime": {
          "type": "integer",
          "format": "int64"
        },
        "nameLocalizationKey": {
          "type": "string"
        },
        "osxDowngradeAllowed": {
          "type": "boolean"
        },
        "osxTargetVersion": {
          "type": "string"
        },
        "osxTargetVersionUpdateTime": {
          "type": "integer",
          "format": "int64"
        },
        "requestPolicyEngineLibUpdates": {
          "type": "boolean"
        },
        "updateTime": {
          "type": "string",
          "format": "date-time"
        },
        "winDowngradeAllowed": {
          "type": "boolean"
        },
        "winTargetVersion": {
          "type": "string"
        },
        "winTargetVersionUpdateTime": {
          "type": "integer",
          "format": "int64"
        }
      },
      "title": "AgentGroupEntity"
    },
    "AssignAIRActionsWithConnectorsRequest": {
      "type": "object",
      "required": [
        "policyName"
      ],
      "properties": {
        "customActionsToConnectorsMaps": {
          "type": "array",
          "description": "Specifies which connectors are to be used during a custom action invocation.",
          "items": {
            "$ref": "#/definitions/ActionToConnectorsMap"
          }
        },
        "fortinetActionsToConnectorsMaps": {
          "type": "array",
          "description": "Specifies which connectors are to be used during an Fortinet action invocation.",
          "items": {
            "$ref": "#/definitions/ActionToConnectorsMap"
          }
        },
        "policyName": {
          "type": "string",
          "description": "Specifies the policy name."
        }
      },
      "title": "AssignAIRActionsWithConnectorsRequest"
    },
    "AssignAIRActionsWithConnectorsResponse": {
      "type": "object",
      "properties": {
        "actionsToConnectorsMap": {
          "type": "object",
          "description": "The mapping between action and connectors.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "policyName": {
          "type": "string",
          "description": "The policy name."
        }
      },
      "title": "AssignAIRActionsWithConnectorsResponse"
    },
    "AssignCollectorsToPolicyResponse": {
      "type": "object",
      "properties": {
        "ignoredCollectorGroupNames": {
          "type": "array",
          "description": "Specifies the list of collector groups that were already assigned to the policy",
          "items": {
            "type": "string"
          }
        }
      },
      "title": "AssignCollectorsToPolicyResponse"
    },
    "GetPlaybooksResponse": {
      "type": "object",
      "properties": {
        "actionsToConnectorsMap": {
          "type": "object",
          "description": "List of connectors for each action (if applicable).",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "classificationActions": {
          "type": "object",
          "description": "List of actions for each classification",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "collectorGroups": {
          "type": "array",
          "description": "List of collector group names that the policy apply to",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "description": "The description of the policy"
        },
        "id": {
          "type": "integer",
          "format": "int32",
          "description": "The policy ID"
        },
        "name": {
          "type": "string",
          "description": "The policy name"
        },
        "operationMode": {
          "type": "string",
          "description": "The policy mode",
          "enum": [
            "Simulation",
            "Prevention"
          ]
        },
        "organization": {
          "type": "string",
          "description": "The organization of the policy"
        }
      },
      "title": "GetPlaybooksResponse"
    },
