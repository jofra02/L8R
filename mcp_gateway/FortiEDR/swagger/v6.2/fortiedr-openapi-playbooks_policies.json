    "/management-rest/playbooks-policies/set-mode": {
      "put": {
        "tags": [
          "Playbooks-policies"
        ],
        "summary": "set-mode",
        "description": "Set playbook to simulation/prevention",
        "operationId": "set-mode",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "mode",
            "in": "query",
            "description": "Operation mode",
            "required": true,
            "type": "string",
            "enum": [
              "Simulation",
              "Prevention"
            ]
          },
          {
            "name": "organization",
            "in": "query",
            "description": "Specifies the name of a specific organization. The value that you specify here must match exactly",
            "required": false,
            "type": "string"
          },
          {
            "name": "policyName",
            "in": "query",
            "description": "Specifies security policy name",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "deprecated": false
