        },
        "localizedName": {
          "type": "string"
        },
        "maxContentVersion": {
          "type": "string"
        },
        "minContentVersion": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "operationMode": {
          "type": "string",
          "enum": [
            "Simulation",
            "Prevention"
          ]
        },
        "origin": {
