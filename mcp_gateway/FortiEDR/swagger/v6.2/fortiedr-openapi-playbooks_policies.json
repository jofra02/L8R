            "$ref": "#/definitions/PolicyToWorkloadGroupAssociationEntity"
          }
        },
        "policyType": {
          "type": "string",
          "enum": [
            "Exfiltration",
            "Ransomware",
            "Whitelisting",
            "AV",
            "AIR",
            "DeviceControl",
            "ApplicationControl",
            "ThreatHuntingSetting",
            "Exclusion",
            "XDR",
            "SecurityExclusion",
            "HostFirewall",
            "DiskEncryption"
          ]
        },
        "preventionInSnapshot": {
          "type": "boolean"
        },
        "updateTime": {
          "type": "string",
          "format": "date-time"
        },
