  "paths": {
    "/management-rest/playbooks-policies/assign-collector-group": {
      "put": {
        "tags": [
          "Playbooks-policies"
        ],
        "summary": "assign-collector-group",
        "description": "Assign collector group to air policy",
        "operationId": "assign-collector-group",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "collectorGroupNames",
            "in": "query",
            "description": "Specifies the list of collector group names",
            "required": true,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "forceAssign",
            "in": "query",
            "description": "Indicates whether to force the assignment even if the group is assigned to similar policies",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "organization",
            "in": "query",
            "description": "Specifies the name of a specific organization. The value that you specify here must match exactly",
            "required": false,
            "type": "string"
          },
          {
            "name": "policyName",
            "in": "query",
            "description": "Specifies policy name",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/AssignCollectorsToPolicyResponse"
            }
          },
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "deprecated": false
      }
    },
    "/management-rest/playbooks-policies/clone": {
      "post": {
        "tags": [
          "Playbooks-policies"
        ],
        "summary": "clone",
        "description": "clone policy",
        "operationId": "clone",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "newPolicyName",
            "in": "query",
            "description": "Specifies security policy target name.",
            "required": true,
            "type": "string",
            "maxLength": 50,
            "minLength": 1
          },
          {
            "name": "organization",
            "in": "query",
            "description": "Specifies the name of a specific organization. The value that you specify here must match exactly",
            "required": true,
            "type": "string"
          },
          {
            "name": "sourcePolicyName",
            "in": "query",
            "description": "Specifies security policy source name",
            "required": true,
            "type": "string",
            "maxLength": 50,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/PolicyEntity"
              }
            }
          },
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "deprecated": false
      }
    },
    "/management-rest/playbooks-policies/list-policies": {
      "get": {
        "tags": [
          "Playbooks-policies"
        ],
        "summary": "list-policies",
        "description": "List policies",
        "operationId": "list-policies",
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "organization",
            "in": "query",
            "description": "Specifies the organization. The value that you specify for this parameter indicates how the operation applies to an organization(s). Some parts of the Fortinet Endpoint Protection and Response Platform system have separate, non shared data that is organization-specific. Other parts of the system have data that is shared by all organizations. The value that you specify for the organization parameter, as described below, determines to which organization(s) an operation applies:\n•\tExact organization name – Specifies the name of a specific organization. The value that you specify here must match exactly.\n•\tAll organizations – Indicates that the operation applies to all organizations. In this case, the same data is shared by all organizations.",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GetPlaybooksResponse"
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "deprecated": false
      }
    },
    "/management-rest/playbooks-policies/map-connectors-to-actions": {
      "put": {
        "tags": [
          "Playbooks-policies"
        ],
        "summary": "map-connectors-to-actions",
