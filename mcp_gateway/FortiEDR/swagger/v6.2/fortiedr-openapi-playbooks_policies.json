    "/management-rest/playbooks-policies/set-action-classification": {
      "put": {
        "tags": [
          "Playbooks-policies"
        ],
        "summary": "set-action-classification",
        "description": "Set the air policy actions' classifications.",
        "operationId": "set-action-classification",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "organization",
            "in": "query",
            "description": "Specifies the name of a specific organization. The value that you specify here must match exactly",
            "required": false,
            "type": "string"
          },
          {
            "in": "body",
            "name": "setActionsClassificationRequest",
            "description": "setActionsClassificationRequest",
            "required": true,
