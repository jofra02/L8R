        "operationId": "map-connectors-to-actions",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "assignAIRActionsWithConnectorsRequest",
            "description": "assignAIRActionsWithConnectorsRequest",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AssignAIRActionsWithConnectorsRequest"
            }
          },
          {
            "name": "organization",
            "in": "query",
            "description": "Specifies the name of a specific organization. The value that you specify here must match exactly",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/AssignAIRActionsWithConnectorsResponse"
