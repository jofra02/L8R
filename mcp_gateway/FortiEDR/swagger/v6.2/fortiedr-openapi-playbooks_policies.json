          "type": "string",
          "format": "date-time"
        },
        "workloadsGroup": {
          "$ref": "#/definitions/WorkloadsGroupEntity"
        }
      },
      "title": "PolicyToWorkloadGroupAssociationEntity"
    },
    "SetActionsClassificationRequest": {
      "type": "object",
      "required": [
        "policyName"
      ],
      "properties": {
        "customActionsToClassificationMaps": {
          "type": "array",
          "description": "Specifies which custom actions' classifications should be enabled. Missing classifications are disabled.",
          "items": {
            "$ref": "#/definitions/ActionsToClassificationMap"
          }
        },
        "fortinetActionsToClassificationMaps": {
          "type": "array",
          "description": "Specifies which Fortinet actions' classifications should be enabled. Missing classifications are disabled.",
          "items": {
            "$ref": "#/definitions/ActionsToClassificationMap"
          }
        },
        "policyName": {
          "type": "string",
          "description": "Specifies the policy name."
        }
      },
      "title": "SetActionsClassificationRequest"
    },
    "SetActionsClassificationResponse": {
      "type": "object",
      "properties": {
        "actionsToClassificationsMap": {
          "type": "object",
