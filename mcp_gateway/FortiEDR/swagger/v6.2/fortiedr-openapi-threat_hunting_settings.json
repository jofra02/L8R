  "definitions": {
    "ThreatHuntingAssignGroupsRequest": {
      "type": "object",
      "required": [
        "associatedCollectorGroupIds",
        "name"
      ],
      "properties": {
        "associatedCollectorGroupIds": {
          "type": "array",
          "description": "List of associated collector groups Ids, for example [1,2,3].",
          "items": {
            "type": "integer",
            "format": "int32"
          }
        },
        "name": {
          "type": "string",
          "description": "Threat Hunting profile name."
        },
        "organization": {
          "type": "string",
          "description": "Specifies the name of a specific organization. The value that you specify here must match exactly"
        }
      },
      "title": "ThreatHuntingAssignGroupsRequest"
    },
    "ThreatHuntingCategoryDtoItem": {
      "type": "object",
      "required": [
        "enabled",
        "eventTypes",
        "identifier"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "When set to True the Threat Hunting event type category is enabled."
        },
        "eventTypes": {
          "type": "array",
          "description": "A subset of the category's event types (identifiers) which will be set to Enabled. For example [\"Process Termination\", \"Process Creation\"]",
          "items": {
            "type": "string"
          }
        },
        "identifier": {
          "type": "string",
          "description": "Threat Hunting event type category identifier"
        }
      },
      "title": "ThreatHuntingCategoryDtoItem"
    },
    "ThreatHuntingCategoryMetadata": {
      "type": "object",
      "required": [
        "categoryIdentifier",
        "categoryName",
        "eventTypes"
      ],
      "properties": {
        "categoryIdentifier": {
          "type": "string",
          "description": "The Threat Hunting category identifier."
        },
        "categoryName": {
          "type": "string",
          "description": "Category name."
        },
        "eventTypes": {
          "type": "array",
          "description": "List of Threat Hunting event types that can be used during the configuration of Threat Hunting Setting profile.",
          "items": {
            "$ref": "#/definitions/ThreatHuntingEventType"
          }
        }
      },
      "title": "ThreatHuntingCategoryMetadata"
    },
    "ThreatHuntingEventType": {
      "type": "object",
      "required": [
        "identifier",
        "name"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "description": "The Threat Hunting event type identifier."
        },
        "name": {
          "type": "string",
          "description": "The Threat Hunting event type name."
        }
      },
      "title": "ThreatHuntingEventType"
    },
    "ThreatHuntingProfileResponse": {
      "type": "object",
      "required": [
        "associatedCollectorGroupIds",
        "immutable",
        "name",
        "threatHuntingCategoryList"
      ],
      "properties": {
        "associatedCollectorGroupIds": {
          "type": "array",
          "description": "List of associated collector groups Ids, for example [1,2,3].",
          "items": {
            "type": "integer",
            "format": "int32"
          }
        },
        "immutable": {
          "type": "boolean",
          "description": "When true this profile cannot be modified."
        },
        "name": {
          "type": "string",
          "description": "Threat Hunting profile name."
        },
        "threatHuntingCategoryList": {
          "type": "array",
          "description": "Threat Hunting Categories",
          "items": {
            "$ref": "#/definitions/ThreatHuntingCategoryDtoItem"
          }
        }
      },
      "title": "ThreatHuntingProfileResponse"
    },
    "ThreatHuntingUpdateRequest": {
      "type": "object",
      "required": [
        "associatedCollectorGroupIds",
        "name",
        "organization",
        "threatHuntingCategoryList"
      ],
      "properties": {
        "associatedCollectorGroupIds": {
          "type": "array",
          "description": "List of associated collector groups Ids, for example [1,2,3].",
          "items": {
            "type": "integer",
            "format": "int32"
          }
        },
        "name": {
          "type": "string",
          "description": "Threat Hunting profile name."
        },
        "newName": {
          "type": "string",
          "description": "New profile name. Optional."
        },
        "organization": {
          "type": "string",
          "description": "Specifies the name of a specific organization. The value that you specify here must match exactly"
        },
        "threatHuntingCategoryList": {
          "type": "array",
          "description": "Threat Hunting Categories",
          "items": {
            "$ref": "#/definitions/ThreatHuntingCategoryDtoItem"
          }
        }
      },
      "title": "ThreatHuntingUpdateRequest"
    }
