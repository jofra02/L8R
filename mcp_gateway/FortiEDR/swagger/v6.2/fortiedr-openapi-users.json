  "definitions": {
    "GetCreateUserRequest": {
      "type": "object",
      "required": [
        "confirmPassword",
        "email",
        "firstName",
        "lastName",
        "password",
        "role",
        "username"
      ],
      "properties": {
        "confirmPassword": {
          "type": "string",
          "description": "Specifies the confirm login password"
        },
        "customScript": {
          "type": "boolean",
          "description": "Is user can upload custom scripts"
        },
        "email": {
          "type": "string",
          "description": "Specifies the email of user"
        },
        "firstName": {
          "type": "string",
          "description": "Specifies the first name of user"
        },
        "lastName": {
          "type": "string",
          "description": "Specifies the last name of user"
        },
        "password": {
          "type": "string",
          "description": "Specifies the login password"
        },
        "remoteShell": {
          "type": "boolean",
          "description": "Is user can use remote shell"
        },
        "restApi": {
          "type": "boolean",
          "description": "Is user can access by rest to the api"
        },
        "role": {
          "type": "string",
          "description": "Specifies the roles of the user",
          "enum": [
            "Admin",
            "Senior Analyst",
            "Read-Only",
            "Analyst",
            "IT"
          ]
        },
        "title": {
          "type": "string",
          "description": "Specifies the title of user"
        },
        "username": {
          "type": "string",
          "description": "Specifies the login username of the user"
        }
      },
      "title": "GetCreateUserRequest"
    },
    "GetUserAuthenticationRequest": {
