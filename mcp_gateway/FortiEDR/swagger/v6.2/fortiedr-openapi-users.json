        "role": {
          "type": "string",
          "description": "Specifies the roles of the user",
          "enum": [
            "Admin",
            "Senior Analyst",
            "Read-Only",
            "Analyst",
            "IT"
          ]
        },
        "title": {
          "type": "string",
          "description": "Specifies the title of user"
        },
        "username": {
          "type": "string",
          "description": "Specifies the login username of the user"
        }
      },
      "title": "GetUserRequest"
    },
    "GetUserResponse": {
      "type": "object",
      "properties": {
        "customScript": {
          "type": "boolean",
          "description": "Is user can upload custom scripts"
        },
        "email": {
          "type": "string",
          "description": "Specifies the email of the user"
        },
        "firstName": {
          "type": "string",
          "description": "Specifies the first name of the user"
        },
        "id": {
          "type": "integer",
          "format": "int32",
          "description": "Specifies the ID of the user"
        },
        "lastName": {
          "type": "string",
          "description": "Specifies the last name of the user"
        },
        "organization": {
          "type": "string",
          "description": "The organization of the user"
        },
        "rbacRole": {
          "type": "string",
