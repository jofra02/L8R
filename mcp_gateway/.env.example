# ── Tenant ──────────────────────────────────────────────
# The gateway is multi-tenant: the tenant is resolved per request (the app
# sends it as a header). DEFAULT_TENANT is an OPTIONAL fallback used only for
# requests without a 'tenant' header (manual curl / single-tenant). It matches
# a folder in mcp_gateway/inventory/tenants/ and a support_ai_agent customer_id.
# ACTIVE_CUSTOMER_ID / ACTIVE_TENANT are accepted as legacy aliases.
# DEFAULT_TENANT=fake_client

# ── Security ────────────────────────────────────────────
# Fernet key for decrypting ENC(...) inventory secrets.
# Generate with: uv run python scripts/encrypt_secret.py --generate
INVENTORY_MASTER_KEY=

# Shared secret for the inventory admin API (X-Admin-Token header).
# Leave empty to disable the admin endpoints (they answer 503).
GATEWAY_ADMIN_TOKEN=

# Inventory location override (defaults to mcp_gateway/inventory)
# INVENTORY_ROOT=

# ── Server ──────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_TRANSPORT=sse
UVICORN_RELOAD=false
LOG_LEVEL=info

# ── HTTP client ─────────────────────────────────────────
GATEWAY_HTTP_TIMEOUT=10
GATEWAY_HTTP_CONNECT_TIMEOUT=5
