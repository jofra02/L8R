  "paths": {
    "/webcache/stats": {
      "get": {
        "tags": [
          "webcache"
        ],
        "summary": "Retrieve webcache statistics.\nAccess Group: Not Specified",
        "responses": {
          "200": {
            "description": "OK: Request returns successful"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "424": {
            "$ref": "#/components/responses/424"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "description": "Statistics period [10min|hour|day|month].",
            "required": false,
            "type": "string"
          }
        ],
        "operationId": "get_webcache_stats"
