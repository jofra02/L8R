          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "serial": {
                    "description": "Serial number of an HA cluster member to register to login to FortiCare. Current device will be selected if not set.",
                    "type": "string"
                  },
                  "email": {
                    "description": "Account email.",
                    "type": "string"
                  },
                  "password": {
                    "description": "Account password.",
                    "type": "string"
