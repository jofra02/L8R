                  "title": "Successful",
                  "description": "True when the registration is successful.",
                  "type": "boolean"
                },
                "forticare_agreement": {
                  "title": "Agreement",
                  "description": "True when agreement is accepted.",
                  "type": "boolean"
                }
              }
