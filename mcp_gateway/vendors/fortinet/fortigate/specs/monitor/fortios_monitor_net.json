    "/network/debug-flow/start": {
      "post": {
        "tags": [
          "network"
        ],
        "operationId": "post_network_debug_flow_start",
        "summary": "Start debug flow packet capture.\nAccess Group: netgrp.packet-capture",
        "responses": {
          "200": {
            "description": "OK: Request returns successful"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "424": {
            "$ref": "#/components/responses/424"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "num_packets": {
                    "description": "Number of packets.",
                    "type": "integer"
                  },
                  "ipv6": {
                    "description": "Whether we are debugging IPv6 traffic.",
                    "type": "boolean"
                  },
                  "negate": {
                    "description": "Inverse IPv4 or IPv6 filter.",
                    "type": "boolean"
                  },
                  "addr_from": {
                    "description": "IPv4 or IPv6 address start of range.",
                    "type": "string"
                  },
                  "addr_to": {
                    "description": "IPv4 or IPv6 address end of range.",
                    "type": "string"
                  },
                  "daddr_from": {
                    "description": "Destination IPv4 or IPv6 address start of range.",
                    "type": "string"
                  },
                  "daddr_to": {
                    "description": "Destination IPv4 or IPv6 address end of range.",
                    "type": "string"
                  },
                  "saddr_from": {
                    "description": "Source IPv4 or IPv6 address start of range.",
                    "type": "string"
                  },
                  "saddr_to": {
                    "description": "Source IPv4 or IPv6 address end of range.",
                    "type": "string"
                  },
                  "port_from": {
                    "description": "Port from.",
                    "type": "integer"
                  },
                  "port_to": {
                    "description": "Port to.",
                    "type": "integer"
                  },
                  "dport_from": {
                    "description": "Destination port from.",
                    "type": "integer"
                  },
                  "dport_to": {
                    "description": "Destination port to.",
                    "type": "integer"
                  },
                  "sport_from": {
                    "description": "Source port from.",
                    "type": "integer"
                  },
                  "sport_to": {
                    "description": "Source port to.",
                    "type": "integer"
                  },
                  "proto": {
                    "description": "Protocol number.",
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            }
          },
          "description": "Possible parameters to go in the body for the request.",
          "required": true
        }
      }
