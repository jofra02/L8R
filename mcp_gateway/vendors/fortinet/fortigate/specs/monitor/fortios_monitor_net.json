  "paths": {
    "/network/arp": {
      "get": {
        "tags": [
          "network"
        ],
        "operationId": "get_network_arp",
        "summary": "Get IPv4 ARP table.\nAccess Group: sysgrp.cfg",
        "responses": {
          "200": {
            "description": "OK: Request returns successful",
            "schema": {
              "title": "IPv4 ARP Table",
              "description": "List of IPv4 ARP associations for IP addresses to MAC addresses.",
              "type": "array",
              "items": {
                "title": "IPv4 ARP Entry",
                "description": "An IPv4 ARP entry.",
                "type": "object",
                "properties": {
                  "ip": {
                    "type": "string",
                    "title": "IP Address",
                    "description": "IP address of the ARP device."
                  },
                  "age": {
                    "type": "integer",
                    "title": "ARP Age",
                    "description": "Age of this ARP entry, in seconds."
                  },
                  "interface": {
                    "type": "string",
                    "title": "Interface Name",
                    "description": "Name of the listening interface."
                  },
                  "mac": {
                    "type": "string",
                    "title": "MAC Address",
                    "description": "MAC address of the ARP device."
                  }
                },
                "required": [
                  "ip",
                  "mac",
                  "interface"
                ]
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "424": {
            "$ref": "#/components/responses/424"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/network/lldp/neighbors": {
      "get": {
        "tags": [
          "network"
        ],
        "operationId": "get_network_lldp_neighbors",
        "summary": "List all active LLDP neighbors.\nAccess Group: netgrp",
        "responses": {
          "200": {
            "description": "OK: Request returns successful",
            "schema": {
              "title": "LLDP Neighbors",
              "description": "Network LLDP neighbors.",
              "type": "array",
              "items": {
                "title": "LLDP Neighbor",
                "description": "Information about LLDP neighbor.",
                "type": "object",
                "required": [
                  "mac",
                  "port",
                  "ttl"
                ],
                "properties": {
                  "port": {
                    "type": "integer",
                    "title": "FortiGate Port Index",
                    "description": "Index of the FortiGate port where LLDP neighbor information was received."
                  },
                  "port_name": {
                    "type": "string",
                    "title": "FortiGate Port Name",
                    "description": "Name of the FortiGate port where LLDP neighbor information was received."
                  },
                  "mac": {
                    "type": "string",
                    "title": "MAC Address",
                    "description": "MAC address."
                  },
                  "chassis_id": {
                    "type": "string",
                    "title": "Chassis ID",
                    "description": "Chassis ID."
                  },
                  "port_id": {
                    "type": "string",
                    "title": "LLDP Neighbor Port ID",
                    "description": "LLDP neighbor port ID."
                  },
                  "port_desc": {
                    "type": "string",
                    "title": "LLDP Neighbor Port Description",
                    "description": "LLDP neighbor port description."
                  },
                  "system_name": {
                    "type": "string",
                    "title": "System Name",
                    "description": "System name."
                  },
                  "system_desc": {
                    "type": "string",
                    "title": "System Description",
                    "description": "System description."
                  },
                  "ttl": {
                    "type": "integer",
                    "title": "TTL",
                    "description": "Time-To-Live value."
                  },
                  "addresses": {
                    "type": "array",
                    "title": "LLDP Addresses",
                    "description": "LLDP addresses.",
                    "items": {
                      "title": "LLDP Address",
                      "description": "LLDP address.",
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "title": "Type",
                          "description": "Type of address.",
                          "enum": [
                            "ipv4",
                            "ipv6"
                          ]
                        },
                        "address": {
                          "type": "string",
                          "title": "Address",
                          "description": "IPv4 or IPv6 address."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "424": {
            "$ref": "#/components/responses/424"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/scope"
          },
          {
            "name": "port",
            "in": "query",
            "description": "Filter: specific port name.",
            "required": false,
            "type": "string"
          }
        ]
      }
    },
    "/network/lldp/ports": {
      "get": {
        "tags": [
          "network"
        ],
        "operationId": "get_network_lldp_ports",
        "summary": "List all active LLDP ports.\nAccess Group: netgrp",
        "responses": {
          "200": {
            "description": "OK: Request returns successful",
            "schema": {
              "title": "LLDP Ports",
              "description": "Network LLDP information from FortiGate ports.",
              "type": "array",
              "items": {
                "title": "LLDP Port",
                "description": "FortiGate port LLDP information.",
                "type": "object",
                "required": [
                  "name",
                  "rx",
                  "neighbors"
                ],
                "properties": {
                  "index": {
                    "type": "number",
                    "title": "FortiGate Port Index",
                    "description": "FortiGate port index."
                  },
                  "name": {
                    "type": "string",
                    "title": "FortiGate Port Name",
                    "description": "FortiGate port name."
                  },
                  "rx": {
                    "type": "integer",
                    "title": "Received LLDP Transmissions",
                    "description": "Number of received LLDP transmissions."
                  },
                  "neighbors": {
                    "type": "integer",
                    "title": "LLDP Neighbors Count",
                    "description": "Number of LLDP neighbors in port."
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "424": {
            "$ref": "#/components/responses/424"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "parameters": [
          {
            "name": "mkey",
            "in": "query",
            "description": "Filter: specific port name.",
            "required": false,
            "type": "string"
          },
          {
            "$ref": "#/components/parameters/scope"
          }
        ]
      }
    },
