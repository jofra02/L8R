    "/webfilter/category-quota": {
      "get": {
        "tags": [
          "webfilter"
        ],
        "operationId": "get_webfilter_category_quota",
        "summary": "Retrieve quota usage statistics for webfilter categories.\nAccess Group: utmgrp.webfilter",
        "responses": {
          "200": {
            "description": "OK: Request returns successful",
            "schema": {
              "title": "Quota Usage Statistics for Webfilter Categories",
              "description": "Quota usage statistics for webfilter categories.",
              "type": "array",
              "items": {
                "x-anyOf": [
                  {
                    "type": "object",
                    "description": "Webfilter profile quota.",
                    "title": "Webfilter Profile Quota",
                    "required": [
                      "id",
                      "category"
                    ],
                    "properties": {
                      "id": {
                        "type": "integer",
                        "description": "Profile ID.",
                        "title": "Profile ID"
                      },
                      "category": {
                        "type": "string",
                        "description": "Category.",
                        "title": "Category"
                      },
                      "time": {
                        "type": "integer",
                        "description": "Time usage.",
                        "title": "Time"
                      },
                      "remaining_time": {
                        "type": "integer",
                        "description": "Available time remaining.",
                        "title": "Remaining Time"
                      },
                      "traffic": {
                        "type": "integer",
                        "description": "Traffic usage.",
                        "title": "Traffic"
                      },
                      "remaining_traffic": {
                        "type": "integer",
                        "description": "Available byte traffic remaining.",
                        "title": "Remaining Traffic"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "description": "Webfilter user quota.",
                    "title": "Webfilter User Quota",
                    "required": [
                      "profile",
                      "time",
                      "traffic"
                    ],
                    "properties": {
                      "user": {
                        "type": "string",
                        "description": "User.",
                        "title": "User"
                      },
                      "ip6": {
                        "type": "string",
                        "description": "Endpoint IPv6 address.",
                        "title": "Endpoint IPv6 Address"
                      },
                      "ip": {
                        "type": "string",
                        "description": "Endpoint IP address.",
                        "title": "Endpoint IP Address"
                      },
                      "profile": {
                        "type": "string",
                        "description": "Webfilter profile.",
                        "title": "Webfilter Profile"
                      },
                      "time": {
                        "type": "integer",
                        "description": "Time usage.",
                        "title": "Time"
                      },
                      "traffic": {
                        "type": "integer",
                        "description": "Traffic usage.",
                        "title": "Traffic"
                      }
                    }
                  }
                ]
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "424": {
            "$ref": "#/components/responses/424"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "parameters": [
          {
            "name": "profile",
            "in": "query",
            "description": "Webfilter profile.",
            "required": false,
            "type": "string"
          },
          {
            "name": "user",
            "in": "query",
            "description": "User or IP (required if profile specified).",
            "required": false,
            "type": "string"
          }
        ]
      }
