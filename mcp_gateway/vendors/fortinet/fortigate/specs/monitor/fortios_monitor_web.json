    "/webfilter/fortiguard-categories": {
      "get": {
        "tags": [
          "webfilter"
        ],
        "operationId": "get_webfilter_fortiguard_categories",
        "summary": "Return FortiGuard web filter categories.\nAccess Group: any",
        "responses": {
          "200": {
            "description": "OK: Request returns successful",
            "schema": {
              "title": "FortiGuard Webfilter Categories",
              "description": "List of FortiGuard webfilter categories.",
              "type": "array",
              "items": {
                "title": "FortiGuard Webfilter Category",
                "description": "A FortiGuard webfilter category.",
                "type": "object",
                "required": [
                  "id",
                  "group_id",
                  "group"
                ],
                "properties": {
                  "id": {
                    "title": "Category ID",
                    "description": "Webfilter category ID.",
                    "type": "integer"
                  },
                  "group_id": {
                    "title": "Category Group ID",
                    "description": "Webfilter category group ID.",
                    "type": "integer"
                  },
                  "group": {
                    "title": "Category Group",
                    "description": "Webfilter category group.",
                    "type": "string"
                  },
                  "rating": {
                    "title": "Category Rating",
                    "description": "Webfilter category rating.",
                    "type": "string"
                  },
                  "name": {
                    "title": "Category Name",
                    "description": "Webfilter category name.",
                    "type": "string"
                  },
                  "default_wf_action": {
                    "title": "Default Action",
                    "description": "Default webfilter category action.",
                    "type": "string"
                  },
                  "blocked_in_ratings": {
                    "type": "array",
                    "title": "Blocked in Ratings",
                    "description": "Blocked in ratings.",
                    "items": {
                      "type": "string",
                      "title": "One Rating",
                      "description": "One rating."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "424": {
            "$ref": "#/components/responses/424"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "parameters": [
          {
            "name": "include_unrated",
            "in": "query",
            "description": "Include Unrated category in result list.",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "convert_unrated_id",
            "in": "query",
            "description": "Convert Unrated category id to the one for CLI use.",
            "required": false,
            "type": "boolean"
          }
        ]
      }
    },
