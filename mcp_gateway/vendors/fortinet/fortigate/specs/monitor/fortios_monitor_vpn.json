                    "description": "Wizard type."
                  },
                  "connection_count": {
                    "type": "number",
                    "title": "Connection Count",
                    "description": "Number of connections."
                  },
                  "creation_time": {
                    "type": "number",
                    "title": "Creation Time",
                    "description": "Seconds elapsed since the tunnel was created."
                  },
                  "username": {
                    "type": "string",
                    "title": "Username",
                    "description": "Username."
                  },
                  "xauth_user": {
                    "type": "string",
                    "title": "XAUTH User",
                    "description": "XAUTH user."
                  },
                  "xauth_user_two_factor_auth": {
                    "type": "boolean",
                    "title": "XAUTH Two Factor Authentication",
                    "description": "True when two factor authentication is in use."
                  },
                  "fct_uid": {
                    "type": "string",
                    "title": "FortiClient UID",
                    "description": "UID of FortiClient."
                  },
                  "peer_sn": {
                    "x-hidden": true,
                    "type": "string",
                    "title": "Peer FortiGate Serial Number",
                    "description": "Serial number of peer FortiGate."
                  },
                  "type": {
                    "type": "string",
