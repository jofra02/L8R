  "info": {
    "title": "Fortinet Endpoint Protection and Response Platform RESTful API",
    "version": "6.2"
  },
  "openapi": "3.0.3",
  "paths": {
    "/management-rest/organizations/create-organization": {
      "post": {
        "deprecated": false,
        "description": "This API creates organization in the system (only for Admin role)",
        "operationId": "organizations_create_organization",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccountRequest"
              }
            }
          },
          "description": "createAccountRequest",
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "summary": "create-organization",
        "tags": [
          "Organizations"
        ]
      }
    },
    "/management-rest/organizations/delete-organization": {
      "delete": {
        "deprecated": false,
        "description": "This API delete organization in the system (only for Admin role)",
        "operationId": "organizations_delete_organization",
        "parameters": [
          {
            "description": "Specifies the name of a specific organization. The value that you specify here must match exactly",
            "in": "query",
            "name": "organization",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "summary": "delete-organization",
        "tags": [
          "Organizations"
        ]
      }
    },
    "/management-rest/organizations/export-organization": {
      "get": {
        "deprecated": false,
        "description": "Export organization data as zip file",
        "operationId": "get_organizations_export_organization",
        "parameters": [
          {
            "description": "The organization destination name",
            "in": "query",
            "name": "destinationName",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Organization to export",
            "in": "query",
            "name": "organization",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamingResponseBody"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "summary": "export-organization",
        "tags": [
          "Organizations"
        ]
      }
    },
    "/management-rest/organizations/import-organization": {
      "post": {
        "deprecated": false,
        "description": "Import organization",
        "operationId": "organizations_import_organization",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "description": "Export zip file",
                    "format": "binary",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetImportAccountResponse"
                }
              }
            },
            "description": "OK"
          },
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "summary": "import-organization",
        "tags": [
          "Organizations"
        ]
      }
    },
    "/management-rest/organizations/list-organizations": {
      "get": {
        "deprecated": false,
        "description": "This API call outputs a list of the accounts in the system.",
