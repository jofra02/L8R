            "description": "OK"
          },
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "summary": "transfer-collectors",
        "tags": [
          "Organizations"
        ]
      }
    },
    "/management-rest/organizations/transfer-collectors-stop": {
      "post": {
        "deprecated": false,
        "description": "Transfer collector stop",
        "operationId": "organizations_transfer_collectors_stop",
        "parameters": [
          {
            "allowEmptyValue": false,
            "description": "Specifies the organization which the migration process should stop",
            "in": "query",
            "name": "organization",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
