              "$ref": "#/components/schemas/Map"
            },
            "type": "array"
          },
          "collectorVersions": {
            "description": "Specifies the collector versions",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "collectorVersionsV2": {
            "description": "Specifies the collector versions with counts per version",
            "items": {
              "$ref": "#/components/schemas/Map"
            },
            "type": "array"
          },
          "collectorsDegradedState": {
            "additionalProperties": {
              "format": "int32",
              "type": "integer"
            },
            "description": "Specifies the collector’s degraded state: FailedConfigurationUpdate, GatewayUnreachable, PAEDisabled, ContentUpdateError, unsupportedOSVersion, DriverLoadFailure, ApproveKernelExtensions, NoConfiguration, NoDiskSpace, MissingMiniFilterSupport, OTIFailed, LostConnection, MissingPolicyEngine, UsingPreviousPolicyEngineFailedToUpgrade, BSOD, DriverVerifierDetected, OsxNetworkExtensionNotApproved, OsxEndpointSecurityExtensionNotApproved, OsxNeitherExtensionIsApproved, OsxFortiEdrWasNotGrantedFullDiskAccess, OsxEndpointSecurityExtensionWasNotGrantedFullDiskAccess and provides a count for each of them",
            "type": "object"
          },
          "collectorsDisconnectedState": {
            "additionalProperties": {
              "format": "int32",
              "type": "integer"
            },
            "description": "Specifies the collector’s disconnected state: disconnected, expired, migrated, pending migrated and provides a count for each of them",
            "type": "object"
          },
          "collectorsRunningState": {
            "additionalProperties": {
              "format": "int32",
              "type": "integer"
            },
            "description": "Specifies the collector’s running state: autonomously, core and provides a count for each of them",
            "type": "object"
          },
          "collectorsState": {
            "additionalProperties": {
              "format": "int32",
              "type": "integer"
            },
            "description": "Specifies the collector’s state: Running, Disconnected, Disabled, Degraded or RebootPending, and provides a count for each of them",
            "type": "object"
          },
          "collectorsWithDumps": {
            "additionalProperties": {
              "format": "int32",
              "type": "integer"
            },
            "description": "Specifies the collector’s that has crash dumps: NsloCollectorService, NsloCollector, WindowsKernelMini, WindowsKernelFull, LinuxKernelPanic, MacOSKernelPanic, and provides a count for each of them",
            "type": "object"
          },
          "contentVersion": {
            "description": "Specifies the content version",
            "type": "string"
          },
          "cores": {
            "description": "Specifies the list of cores. Each core holds the following parameters (supported in V2.7.3 and above):\n•\tname: Specifies the core device name.\n•\taddress: Specifies the core IP address.\n•\tversion: Specifies the core version.\n•\tstatus: Indicates the status of the core: Enabled/Degraded.",
            "items": {
              "$ref": "#/components/schemas/Map"
            },
            "type": "array"
          },
          "customerName": {
            "description": "Specifies the customer name",
            "type": "string"
          },
          "ecsRegistrationURL": {
            "description": "Specifies the ECS registration URL",
            "type": "string"
          },
          "ecsStatus": {
            "description": "Specifies the ECS status. Possible values are: Disabled, Enabled, Degraded, Down",
            "type": "string"
          },
          "ecsStatusMessage": {
            "description": "Specifies the ECS status details.",
            "type": "string"
          },
          "environmentUniqueId": {
            "description": "Specifies the management ID as defined in ECS",
            "type": "string"
          },
          "installationId": {
            "description": "Specifies the installation ID",
            "format": "int64",
            "type": "integer"
          },
          "iotDevicesInUse": {
            "description": "Specifies the IoT devices in use",
            "format": "int32",
            "type": "integer"
          },
          "iotDevicesLicenseCapacity": {
            "description": "Specifies the IoT device’s license capacity",
            "format": "int32",
            "type": "integer"
          },
          "licenseBlob": {
            "description": "License blob",
            "type": "string"
          },
          "licenseExpirationDate": {
            "description": "Specifies the license expiration date",
            "type": "string"
          },
          "licenseFeatures": {
            "description": "Specifies the license features assigned to you, which can include the following:\n•\tThreat Hunting\n•\tForensics\n•\tCommunication Control\n•\tProtect Anywhere \n•\tVulnerability\n•\tIoT\n•\teXtended Detection\n",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "licenseType": {
            "description": "Specifies the license type. Possible values are (separated by ;): Discover, Protect and Response; Discover, Protect and Response [On-Premise]; Discover and Protect; Protect and Response",
            "type": "string"
          },
          "managementExternalIP": {
            "description": "Specifies the management external IP",
            "type": "string"
          },
          "managementHostname": {
            "description": "Specifies the management host name",
            "type": "string"
          },
          "managementInternalIP": {
            "description": "Specifies the management internal IP",
            "type": "string"
          },
          "managementVersion": {
            "description": "Specifies the management version",
            "type": "string"
          },
          "maxAccountCount": {
            "description": "Specifies the max number of organizations limit",
            "format": "int32",
            "type": "integer"
          },
          "registeredCollectors": {
            "description": "Specifies the registered collectors",
            "format": "int32",
            "type": "integer"
          },
          "repositories": {
            "description": "Specifies the list of repositories. Each repository holds the following parameters (supported in V3.5.0 and above):\n•\taddress: Specifies the repository IP address.\n•\tstatus: Indicates the status of the repository: Running/Disconnected",
