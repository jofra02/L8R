      "GetSystemSummaryResponse": {
        "properties": {
          "aggregators": {
            "description": "Specifies the list of aggregators. Each aggregator holds the following parameters (supported in V2.7.3 and above):\n•\tname: Specifies the aggregator device name.\n•\taddress: Specifies the aggregator IP address.\n•\tversion: Specifies the aggregator version.\n•\tstatus: Indicates the status of the aggregator: Enabled/Degraded",
