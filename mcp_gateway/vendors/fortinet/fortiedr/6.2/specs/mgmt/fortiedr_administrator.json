            "format": "int32",
            "type": "integer"
          },
          "serverCollectorsLicenseCapacity": {
            "description": "Specifies the server collector’s license capacity",
            "format": "int32",
            "type": "integer"
          },
          "systemState": {
            "description": "Indicates the system state: Protection/Simulation (supported in V2.7.3 and above)",
